# ============================================================
# SafeWatch Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in every value marked CHANGE_ME.
# Never commit the real .env to Git.

# ── Flask ────────────────────────────────────────────────────
FLASK_DEBUG=false
HOST=0.0.0.0
PORT=5000

# ── Device authentication ────────────────────────────────────
# Generate a strong secret:
#   python -c "import secrets; print(secrets.token_hex(32))"
# The SAME value must be set in the A9G relay script.
DEVICE_SECRET=Sumaya@Lazycat@Thala_Safeband

# ── Firebase ─────────────────────────────────────────────────
# Absolute path to the service-account JSON downloaded from:
# Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_CREDENTIALS_PATH=C:\path\to\your\serviceAccount.json
FIREBASE_DATABASE_URL=https://safe-band-7659f-default-rtdb.asia-southeast1.firebasedatabase.app/

# ── Location history ─────────────────────────────────────────
ENABLE_HISTORY=true
MAX_HISTORY_ENTRIES=500

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/safewatch_backend.log

# ── Waitress ──────────────────────────────────────────────────
WAITRESS_THREADS=4

# ── A9G relay (used by a9g_relay.py, not the server) ─────────
A9G_PORT=COM3
A9G_BAUDRATE=115200
POLL_INTERVAL_SECONDS=30
GPS_FIX_TIMEOUT_SECONDS=180
DEVICE_ID=band_001

# Full URL of your deployed API — fill in after AWS deployment
API_URL=https://CHANGE_ME_your_ec2_ip_or_domain/api/location

# Set to true to test GPS reading without sending to the API
OFFLINE_MODE=false

# SMS settings
SEND_INITIAL_SMS=true
SMS_RECIPIENT=+918019914152
SMS_MESSAGE=SafeBand GPS fix acquired. Tracking has started.
